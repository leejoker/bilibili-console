#!/usr/bin/env ruby

require 'thor'
require 'json'
require_relative '../lib/bilibili_console'
require_relative '../lib/bilibili_console/version'
require_relative '../lib/bilibili_console/constants/comment_type'

at_exit do
  # Thor 的参数错误已经打印过消息并以 SystemExit 退出，这里不要再叠一层 "Error! SystemExit"
  next if $!.nil? || $!.is_a?(SignalException) || $!.is_a?(SystemExit)

  error = $!
  $log&.error("error: #{error.class}: #{error.message}\n#{Array(error.backtrace).join("\n")}")
  puts "Error! #{error.class}: #{error.message}"
  puts 'Please check the error log.'
end

# bilibili-console command line
class BiliConsole < Thor
  BILI_CONSOLE = Bilibili::BilibiliConsole.new

  def self.exit_on_failure?
    true
  end

  map %w[-v --version] => :version

  desc 'version', '查看 bilic 版本'

  def version
    puts "bilic #{Bilibili::VERSION}"
  end

  desc 'config', '查看生效配置（默认值叠加 ~/.bc/bilic.conf）'
  option :json, desc: '以 JSON 输出', type: :boolean

  def config
    opt = Bilibili::Config.new.options
    if options[:json]
      puts JSON.pretty_generate(opt)
    else
      opt.each { |key, value| puts "#{key}: #{value}" }
    end
  end

  desc 'tree', '以树形打印所有命令'

  def tree
    puts 'bili_console'
    # Thor 的 commands 以方法名为键，这里统一取 usage 里的命令名（down/play/tasks…）
    entries = self.class.commands.values.reject(&:hidden?).filter_map do |cmd|
      name = cmd.usage.to_s.split(' ').first
      { name: name, desc: cmd.description.to_s.split("\n").first } unless %w[help tree].include?(name)
    end
    entries.sort_by { |entry| entry[:name] }.each_with_index do |entry, index|
      icon = index == entries.size - 1 ? '└─' : '├─'
      puts "  #{icon} #{entry[:name]} (#{entry[:desc]})"
    end
  end

  desc 'doctor', '检查环境与第三方依赖（aria2c / wget）'

  def doctor
    BILI_CONSOLE.doctor
  end

  desc 'login', '扫码登录并保存 cookie'

  def login
    puts BILI_CONSOLE.do_login
  end

  desc 'user', '查看当前登录用户信息'

  def user
    user = BILI_CONSOLE.login_user_info
    puts <<~USER
      uid: #{user.mid}
      uname: #{user.uname}
      level: #{user.level_info[:current_level]}
      coins: #{user.money}
      moral: #{user.moral}
    USER
  end

  desc 'manga', '哔哩哔哩漫画每日签到'
  option :info, aliases: :i, desc: '只查看签到状态，不执行签到', type: :boolean

  def manga_checkin
    if options[:info]
      body = BILI_CONSOLE.manga_checkin_info
      puts <<~CHECKINFO
        签到状态: #{body[:status] == 1 ? '已签到' : '未签到'}
        连续签到天数: #{body[:day_count]}
      CHECKINFO
    else
      body = BILI_CONSOLE.manga_checkin
      if body.code.to_i == 0
        body = BILI_CONSOLE.manga_checkin_info
        puts <<~CHECKINFO
          签到成功!
          连续签到天数: #{body[:day_count]}
        CHECKINFO
      else
        puts '您已经签到了'
      end
    end
  end

  desc 'down BVID', '按 BV 号下载视频（任务化，支持断点续传）'
  option :start, aliases: :s, desc: '起始分P（默认 1）'
  option :end, aliases: :e, desc: '结束分P'
  option :page, aliases: :p, desc: '只下载指定分P'
  option :qn, aliases: :q, desc: '清晰度 240/360/480/720/1080（默认 720）'
  option :rename, aliases: :r, desc: '重命名下载文件前缀'
  option :list, aliases: :l, desc: '列出已下载的视频', type: :boolean
  option :remove, aliases: :R, desc: '按 BV 号删除已下载的视频', type: :boolean
  option :yes, aliases: :y, desc: '删除时不再询问', type: :boolean
  option :workers, aliases: :w, desc: '并发下载数（默认 1）', default: '1'

  def download_video(id = nil)
    return list_downloaded if options[:list]
    return remove_downloaded(id) if options[:remove]
    raise Thor::RequiredArgumentMissingError, '缺少 BV 号，例如 bilic down BV1xx411c7mD（列已下载用 -l，删除用 -R）' if id.nil?

    options_dup = options.dup
    options_dup[:start] = 1 if options[:start].nil?
    options_dup[:qn] = '720' if options[:qn].nil?
    print_task_summary(BILI_CONSOLE.download_video(id, options_dup))
  end

  desc 'history', '查看观看历史'
  option :page, aliases: :p, desc: '页码（默认 1）', default: '1'
  option :count, aliases: :c, desc: '每页条数（默认 20）', default: '20'

  def history
    items = BILI_CONSOLE.history(options)
    if items.empty?
      puts '没有观看记录，或登录状态已失效（bilic login）'
      return
    end

    items.each do |item|
      puts <<~HISTORY
        bv:        #{item.bvid}
        title:     #{item.title}
        author:    #{item.author_name}
        progress:  #{item.progress}/#{item.duration} (#{item.progress_percent}%)
        watched:   #{item.viewed_at}
        -----------------------------------------------------------------------
      HISTORY
    end
  end

  desc 'play BVID', '用本地播放器播放在线视频'
  option :page, aliases: :p, desc: '分P（默认 1）', default: '1'
  option :qn, aliases: :q, desc: '清晰度 240/360/480/720/1080（默认取配置 video_qn）'
  option :player, desc: '播放器命令，留空依次尝试 mpv / vlc / xdg-open'
  option :no_launch, desc: '只打印播放地址，不启动播放器', type: :boolean

  def play(id = nil)
    raise Thor::RequiredArgumentMissingError, '缺少 BV 号，例如 bilic play BV1xx411c7mD' if id.nil?

    info = BILI_CONSOLE.play(id, options)
    return puts('未找到可播放的分P，请检查 bv 号') if info.nil?

    puts "url:   #{info[:url]}"
    puts "title: #{info[:title]}"
    puts "part:  #{info[:part]}"
    puts '仅输出地址，未启动播放器' if options[:no_launch]
  end

  desc 'saucenao TARGET', '以图搜图（saucenao，需在配置里填 saucenao_api_key）'
  option :db, desc: 'saucenao 库编号（默认 999）', default: '999'

  def saucenao(target = nil)
    raise Thor::RequiredArgumentMissingError, '缺少图片参数，例如 bilic saucenao https://i0.hdslb.com/xxx.jpg' if target.nil?

    results = BILI_CONSOLE.saucenao(target, options)
    return puts('没有匹配结果') if results.empty?

    results.first(5).each do |result|
      puts <<~RESULT
        similarity: #{result.similarity}
        index:      #{result.index_name}
        title:      #{result.title}
        urls:       #{result.urls.join(' ')}
        -----------------------------------------------------------------------
      RESULT
    end
  end

  desc 'tasks [ID]', '查看 / 重试 / 取消 / 删除下载任务'
  option :retry, desc: '重试任务中失败的分片', type: :boolean
  option :cancel, desc: '请求取消正在运行的任务', type: :boolean
  option :remove, desc: '删除任务记录（已下载的文件保留）', type: :boolean
  option :yes, desc: '删除时不再询问', type: :boolean
  option :workers, aliases: :w, desc: '并发下载数（默认 1）', default: '1'

  def tasks(id = nil)
    return list_tasks if id.nil?
    return retry_task(id) if options[:retry]
    return cancel_task(id) if options[:cancel]
    return remove_task(id) if options[:remove]

    show_task(id)
  end

  desc 'fav', '查看收藏夹列表，或在收藏夹内搜索'
  option :search, aliases: :s, desc: '在收藏夹内搜索的关键词'
  option :fav, aliases: :m, desc: '目标收藏夹 id（默认第一个收藏夹）'
  option :page_size, aliases: :p, desc: '每页条数（默认 10）'
  option :page_num, aliases: :n, desc: '页码（默认 1）'
  option :all, aliases: :a, desc: '搜索时包含全部收藏夹', type: :boolean

  def fav_info
    if options[:search].nil? && options[:fav].nil?
      fav_list
    else
      options_dup = options.dup
      fav_search(options_dup)
    end
  end

  desc 'search KEYWORD', '按关键词搜索视频'
  option :page, aliases: :p, desc: '页码（默认 1）'
  option :bv, desc: '按 BV 号精确过滤', type: :boolean
  option :av, desc: '按 AV 号精确过滤', type: :boolean
  option :pic, desc: '保存所选 BV 的封面', type: :boolean
  option :sort, desc: '排序：totalrank(默认) / click / pubdate / dm / stow / scores / attention'

  def search(keyword)
    return if keyword.nil?

    options_dup = options.dup
    options_dup[:page] = 1 if options_dup[:page].nil?
    options_dup[:keyword] = keyword
    data = BILI_CONSOLE.search_keyword(options_dup)
    data&.result&.each do |video|
      puts <<~VIDEO
          av:            #{video.aid}
          bv:            #{video.bvid}
          title:         #{video.title}
          author:        #{video.author}
          desc:          #{video.description}
          pic:           #{video.pic}
          page_size:     #{video.page_size}
        -----------------------------------------------------------------------
      VIDEO
    end
  end

  desc 'vc BVID', '获取视频评论'
  option :page, aliases: :p, desc: '页码（默认 1）'
  option :pic, desc: '下载评论中的图片', type: :boolean

  def vc(keyword = nil)
    raise Thor::RequiredArgumentMissingError, '缺少 BV 号，例如 bilic vc BV1xx411c7mD' if keyword.nil?

    options_dup = options.dup
    options_dup[:oid] = keyword
    options_dup[:type] = Bilibili::Constants::COMMENT_TYPE[:video]
    data = BILI_CONSOLE.video_comments(options_dup)
    if options[:pic]
      puts 'Pictures Downloaded'
    else
      list = data.hots.nil? ? data.replies : data.hots
      list.each do |comment|
        puts <<~COMMENT
          sender id:        #{comment.mid}
          sender name:      #{comment.member[:uname]}
          sender avatar:    #{comment.member[:avatar]}
          sender level:     #{comment.member[:level_info]}
          send time:        #{comment.ctime}

          content:          #{comment.content[:message]}
          content_pic:      #{comment.content[:pictures]}

          ------------------------------------------------------
        COMMENT
      end
    end
  end

  no_commands do
    def list_downloaded
      items = BILI_CONSOLE.downloaded_items
      if items.empty?
        puts '下载目录为空'
        return
      end

      items.each do |item|
        puts <<~DOWNLOADED
          bv:    #{item[:id]}
          title: #{item[:title]}
          files: #{item[:files]}
          size:  #{human_size(item[:size])}
          path:  #{item[:path]}
          -----------------------------------------------------------------------
        DOWNLOADED
      end
    end

    def remove_downloaded(id)
      return puts('usage: bilic down <bvid> --remove [--yes]') if id.nil?

      matched = BILI_CONSOLE.remove_downloaded(id, force: options[:yes])
      if matched.empty?
        puts "未找到 #{id} 的下载记录"
      elsif options[:yes]
        matched.each { |entry| puts "已删除 #{entry}" }
      else
        matched.each { |entry| puts "将删除 #{entry}（加 --yes 确认）" }
      end
    end

    def list_tasks
      tasks = BILI_CONSOLE.download_tasks
      return puts('没有下载任务') if tasks.empty?

      tasks.each { |task| print_task(task) }
    end

    def show_task(id)
      task = BILI_CONSOLE.find_download_task(id)
      return puts("未找到任务 #{id}") if task.nil?

      print_task(task, detail: true)
    end

    def retry_task(id)
      task = BILI_CONSOLE.retry_download_task(id, options)
      return puts("未找到任务 #{id}") if task.nil?

      print_task_summary(task)
    end

    def cancel_task(id)
      task = BILI_CONSOLE.cancel_download_task(id)
      return puts("未找到任务 #{id}") if task.nil?
      return puts("任务 #{task.id} 已完成，无需取消") if task.done?

      puts "已请求取消 #{task.id}（当前状态 #{task.status}）"
    end

    def remove_task(id)
      task = BILI_CONSOLE.remove_download_task(id)
      return puts("未找到任务 #{id}") if task.nil?

      puts "已删除任务记录 #{task.id}（下载文件保留在 #{task.dir}）"
    end

    def print_task(task, detail: false)
      puts <<~TASK
        id:       #{task.id}
        bv:       #{task.bvid}
        title:    #{task.title}
        status:   #{task.status}
        progress: #{task.done_count}/#{task.total} (失败 #{task.failed_count}) #{byte_progress(task)}
        updated:  #{Time.at(task.updated_at).localtime.strftime('%Y-%m-%d %H:%M:%S')}
        dir:      #{task.dir}
      TASK
      return unless detail

      task.segments.each do |segment|
        state = segment[:status]
        error = segment[:error].to_s.empty? ? '' : " (#{segment[:error]})"
        puts "  - #{segment[:name]} [#{state}] #{segment_bytes(task, segment)}#{error}"
      end
    end

    def segment_bytes(task, segment)
      path = File.join(task.dir, segment[:name])
      current = segment[:status] == 'done' ? segment[:size].to_i : (File.file?(path) ? File.size(path) : 0)
      total = segment[:total_size].to_i
      percent = total.positive? ? ((current.to_f / total) * 100).round(1) : nil
      return "#{human_size(current)}" if total.zero?

      "#{human_size(current)} / #{human_size(total)} (#{percent}%)"
    end

    def byte_progress(task)
      return '' if task.total.zero?

      current = task.segments.sum do |segment|
        path = File.join(task.dir, segment[:name])
        segment[:status] == 'done' ? segment[:size].to_i : (File.file?(path) ? File.size(path) : 0)
      end
      total = task.segments.sum { |segment| segment[:total_size].to_i }
      return "(#{human_size(current)})" if total.zero?

      "(#{human_size(current)}/#{human_size(total)} #{(current.to_f / total * 100).round(1)}%)"
    end

    def print_task_summary(task)
      return if task.nil?

      puts "任务：#{task.id} 状态=#{task.status} 分片=#{task.done_count}/#{task.total} 失败=#{task.failed_count}"
      puts "下载目录：#{task.dir}"
      puts '查看任务：bilic tasks；重试失败分片：bilic tasks <id> --retry' if task.failed_count.positive?
    end

    def human_size(bytes)
      units = %w[B KB MB GB TB]
      size = bytes.to_f
      index = 0
      while size >= 1024 && index < units.size - 1
        size /= 1024
        index += 1
      end
      format('%.1f %s', size, units[index])
    end
  end

  private

  def fav_list
    BILI_CONSOLE.user_fav_list.list.each do |fav|
      puts <<~FAV
          fav_id:         #{fav.fid}
          fav_name:       #{fav.title}
          media count:    #{fav.media_count}
        -----------------------------------------------------------------------
      FAV
    end
  end

  def fav_search(options)
    fav = BILI_CONSOLE.user_fav_list.list[0]
    user = BILI_CONSOLE.login_user_info
    options[:fav] = fav.fid.to_s if options[:fav].nil?
    options[:fav] += user.mid.to_s.slice(-2, 2)
    BILI_CONSOLE.list_fav_video(options)&.medias&.each do |media|
      puts <<~MEDIA
          title:         #{media.title}
          intro:         #{media.intro}
          bv:            #{media.bv_id}
        -----------------------------------------------------------------------
      MEDIA
    end
  end
end

BiliConsole.start(ARGV)
